# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# ...except the bridge mod's own prebuilt companion module -- checked in
# deliberately so installing the mod needs no local C build step (it
# compiles in its own copy of UE4SS's Lua, so one prebuilt binary works
# across every game on UE4SS versions sharing that Lua -- v4.0.0+ today;
# see src/ue4ss_mcp_server/native/lua54/NOTICE).
!src/ue4ss_mcp_server/bridge_mod_template/scripts/*.dll


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# ...except real UE4SS.log samples kept as test fixtures (any subfolder --
# this bit twice now, first for fixtures/*.log, then fixtures/crash_samples/*.log)
!tests/fixtures/**/*.log

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/
